# Server-only Supabase configuration. Never prefix these with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Generate an independent random value with at least 32 characters.
SUBMISSION_RATE_LIMIT_SECRET=replace_with_a_long_random_secret

# Admin-panel session encryption and first-admin allowlist.
ADMIN_SESSION_SECRET=replace_with_a_different_random_secret_of_at_least_32_characters
ADMIN_EMAILS=owner@example.com
